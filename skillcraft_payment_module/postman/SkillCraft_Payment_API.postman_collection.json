{
	"info": {
		"_postman_id": "skillcraft-payment-api-v1",
		"name": "SkillCraft.AI — Payment API",
		"description": "Complete Postman collection for the SkillCraft.AI Payment Module.\n\nBefore using:\n1. Set the `base_url` environment variable to `http://127.0.0.1:8000`\n2. Call 'Get JWT Token' first to populate `access_token` automatically.\n3. Valid demo course IDs: 11, 12, 13, 14, 15\n\nFor webhook testing locally:\n1. Install ngrok: https://ngrok.com\n2. Run: ngrok http 8000\n3. Set the webhook URL in Razorpay Dashboard to: https://YOUR_NGROK_URL/api/payments/webhook/\n4. Use the 'Simulate Webhook (Local)' request to test locally.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "razorpay_order_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "razorpay_payment_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "razorpay_signature",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Auth — Get JWT Token",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"testpass123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/token/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"token",
						""
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var json = pm.response.json();",
							"if (json.access) {",
							"    pm.collectionVariables.set('access_token', json.access);",
							"    console.log('Access token saved:', json.access.substring(0, 30) + '...');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": [
				{
					"name": "Success",
					"status": "OK",
					"code": 200,
					"body": "{\n    \"access\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
				}
			]
		},
		{
			"name": "1. Create Individual Course Order",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"purchase_type\": \"course\",\n    \"course_id\": \"12\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/create-order/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"create-order",
						""
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var json = pm.response.json();",
							"if (json.success && json.data) {",
							"    pm.collectionVariables.set('razorpay_order_id', json.data.razorpay_order_id);",
							"    console.log('Order created:', json.data.razorpay_order_id);",
							"    console.log('Amount (paise):', json.data.amount);",
							"    console.log('Amount (INR):', json.data.amount_inr);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": [
				{
					"name": "201 Created — Individual Course",
					"status": "Created",
					"code": 201,
					"body": "{\n    \"success\": true,\n    \"message\": \"Order created successfully\",\n    \"data\": {\n        \"internal_order_id\": \"SCO20261127A1B2C3D4E5\",\n        \"razorpay_order_id\": \"order_P1q2r3s4t5u6v7\",\n        \"amount\": 500000,\n        \"amount_inr\": \"5000.00\",\n        \"currency\": \"INR\",\n        \"purchase_type\": \"course\",\n        \"course_id\": \"12\",\n        \"course_title\": \"DEMO Course 12\",\n        \"razorpay_key_id\": \"rzp_test_XXXXXXXXXXXXXX\",\n        \"reused_existing_order\": false\n    }\n}"
				},
				{
					"name": "400 Bad Request — Invalid course",
					"status": "Bad Request",
					"code": 400,
					"body": "{\n    \"success\": false,\n    \"message\": \"Invalid purchase request.\",\n    \"errors\": {\n        \"course_id\": [\"Invalid or unavailable course.\"]\n    }\n}"
				}
			]
		},
		{
			"name": "2. Create Combo Package Order",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"purchase_type\": \"combo\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/create-order/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"create-order",
						""
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var json = pm.response.json();",
							"if (json.success && json.data) {",
							"    pm.collectionVariables.set('razorpay_order_id', json.data.razorpay_order_id);",
							"    console.log('Combo order created:', json.data.razorpay_order_id);",
							"    console.log('Amount (paise):', json.data.amount, '= Rs', json.data.amount_inr);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"response": [
				{
					"name": "201 Created — Combo Package",
					"status": "Created",
					"code": 201,
					"body": "{\n    \"success\": true,\n    \"message\": \"Order created successfully\",\n    \"data\": {\n        \"internal_order_id\": \"SCO20261127F6G7H8I9J0\",\n        \"razorpay_order_id\": \"order_ComboXXXXXXX\",\n        \"amount\": 2000000,\n        \"amount_inr\": \"20000.00\",\n        \"currency\": \"INR\",\n        \"purchase_type\": \"combo\",\n        \"course_id\": null,\n        \"course_title\": \"Complete Combo Package\",\n        \"razorpay_key_id\": \"rzp_test_XXXXXXXXXXXXXX\",\n        \"reused_existing_order\": false\n    }\n}"
				}
			]
		},
		{
			"name": "3. Verify Payment",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"razorpay_order_id\": \"{{razorpay_order_id}}\",\n    \"razorpay_payment_id\": \"{{razorpay_payment_id}}\",\n    \"razorpay_signature\": \"{{razorpay_signature}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/verify/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"verify",
						""
					]
				}
			},
			"response": [
				{
					"name": "200 OK — Payment Captured",
					"status": "OK",
					"code": 200,
					"body": "{\n    \"success\": true,\n    \"message\": \"Payment verified successfully\",\n    \"data\": {\n        \"internal_order_id\": \"SCO20261127A1B2C3D4E5\",\n        \"razorpay_order_id\": \"order_P1q2r3s4t5u6v7\",\n        \"purchase_type\": \"course\",\n        \"course_id\": \"12\",\n        \"amount\": 500000,\n        \"amount_inr\": \"5000.00\",\n        \"currency\": \"INR\",\n        \"order_status\": \"paid\",\n        \"payment_status\": \"captured\",\n        \"razorpay_payment_id\": \"pay_XXXXXXXXXXXXXXXXX\",\n        \"payment_method\": \"upi\",\n        \"enrollment_activated\": true,\n        \"paid_at\": \"2026-11-27T08:30:00Z\",\n        \"created_at\": \"2026-11-27T08:25:00Z\",\n        \"updated_at\": \"2026-11-27T08:30:00Z\"\n    }\n}"
				},
				{
					"name": "400 Bad Request — Invalid Signature",
					"status": "Bad Request",
					"code": 400,
					"body": "{\n    \"success\": false,\n    \"message\": \"Payment signature verification failed.\",\n    \"errors\": {}\n}"
				},
				{
					"name": "202 Accepted — Authorized but not captured",
					"status": "Accepted",
					"code": 202,
					"body": "{\n    \"success\": true,\n    \"message\": \"Payment is authorized but not yet captured. Access will be activated automatically once the payment is captured.\",\n    \"data\": {\n        \"order_status\": \"pending\",\n        \"payment_status\": \"authorized\",\n        \"enrollment_activated\": false\n    }\n}"
				}
			]
		},
		{
			"name": "4. Payment Webhook (Simulate Locally)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Razorpay-Signature",
						"value": "COMPUTED_HMAC_SHA256_OF_BODY_WITH_WEBHOOK_SECRET"
					},
					{
						"key": "X-Razorpay-Event-Id",
						"value": "evt_TestEvent001"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"entity\": \"event\",\n    \"account_id\": \"acc_Your_Razorpay_Account\",\n    \"event\": \"payment.captured\",\n    \"contains\": [\"payment\"],\n    \"payload\": {\n        \"payment\": {\n            \"entity\": {\n                \"id\": \"pay_TestPaymentXXXXXX\",\n                \"entity\": \"payment\",\n                \"amount\": 500000,\n                \"currency\": \"INR\",\n                \"status\": \"captured\",\n                \"order_id\": \"{{razorpay_order_id}}\",\n                \"method\": \"upi\",\n                \"captured\": true\n            }\n        }\n    },\n    \"created_at\": 1700000000\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/payments/webhook/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"webhook",
						""
					]
				}
			},
			"response": [
				{
					"name": "200 OK — Webhook Processed",
					"status": "OK",
					"code": 200,
					"body": "{\n    \"success\": true,\n    \"message\": \"Payment captured.\",\n    \"data\": {\"event_status\": \"processed\"}\n}"
				},
				{
					"name": "400 Bad Request — Invalid Signature",
					"status": "Bad Request",
					"code": 400,
					"body": "{\n    \"success\": false,\n    \"message\": \"Invalid webhook signature.\",\n    \"errors\": {}\n}"
				}
			]
		},
		{
			"name": "5. Check Payment Status",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/payments/status/{{razorpay_order_id}}/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"status",
						"{{razorpay_order_id}}",
						""
					]
				}
			},
			"response": [
				{
					"name": "200 OK — Status",
					"status": "OK",
					"code": 200,
					"body": "{\n    \"success\": true,\n    \"message\": \"Payment status fetched successfully\",\n    \"data\": {\n        \"internal_order_id\": \"SCO20261127A1B2C3D4E5\",\n        \"razorpay_order_id\": \"order_P1q2r3s4t5u6v7\",\n        \"purchase_type\": \"course\",\n        \"course_id\": \"12\",\n        \"course_title\": \"DEMO Course 12\",\n        \"amount\": 500000,\n        \"amount_inr\": \"5000.00\",\n        \"currency\": \"INR\",\n        \"order_status\": \"paid\",\n        \"payment_status\": \"captured\",\n        \"razorpay_payment_id\": \"pay_XXXXXXXXXXXXXXXXX\",\n        \"payment_method\": \"upi\",\n        \"enrollment_activated\": true,\n        \"paid_at\": \"2026-11-27T08:30:00Z\",\n        \"created_at\": \"2026-11-27T08:25:00Z\",\n        \"updated_at\": \"2026-11-27T08:30:00Z\"\n    }\n}"
				},
				{
					"name": "404 Not Found",
					"status": "Not Found",
					"code": 404,
					"body": "{\n    \"success\": false,\n    \"message\": \"Order not found.\",\n    \"errors\": {}\n}"
				}
			]
		},
		{
			"name": "6. Payment History",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/payments/history/?page=1&page_size=10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"payments",
						"history",
						""
					],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "page_size",
							"value": "10"
						},
						{
							"key": "status",
							"value": "paid",
							"disabled": true
						}
					]
				}
			},
			"response": [
				{
					"name": "200 OK — History",
					"status": "OK",
					"code": 200,
					"body": "{\n    \"success\": true,\n    \"message\": \"Payment history fetched successfully\",\n    \"data\": {\n        \"count\": 2,\n        \"total_pages\": 1,\n        \"current_page\": 1,\n        \"next\": null,\n        \"previous\": null,\n        \"results\": [\n            {\n                \"internal_order_id\": \"SCO20261127A1B2C3D4E5\",\n                \"razorpay_order_id\": \"order_P1q2r3s4t5u6v7\",\n                \"purchase_type\": \"course\",\n                \"course_id\": \"12\",\n                \"course_title\": \"DEMO Course 12\",\n                \"amount\": 500000,\n                \"amount_inr\": \"5000.00\",\n                \"currency\": \"INR\",\n                \"order_status\": \"paid\",\n                \"payment_status\": \"captured\",\n                \"razorpay_payment_id\": \"pay_XXXXXXXXXXXXXXXXX\",\n                \"date\": \"2026-11-27T08:25:00Z\",\n                \"paid_at\": \"2026-11-27T08:30:00Z\"\n            }\n        ]\n    }\n}"
				}
			]
		}
	]
}